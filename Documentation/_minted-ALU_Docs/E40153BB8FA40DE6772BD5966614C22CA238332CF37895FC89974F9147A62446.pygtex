\PYG{c+cm}{/*}
\PYG{c+cm}{Project: 8\PYGZhy{}Bit ALU}
\PYG{c+cm}{Author: Max Fabian}
\PYG{c+cm}{Sources:}
\PYG{c+cm}{    *https://en.wikipedia.org/wiki/Binary\PYGZus{}multiplier\PYGZsh{}Single\PYGZhy{}cycle\PYGZus{}multiplier}
\PYG{c+cm}{    *https://stackoverflow.com/questions/63655634/8\PYGZhy{}bit\PYGZhy{}sequential\PYGZhy{}multiplier\PYGZhy{}using\PYGZhy{}add\PYGZhy{}and\PYGZhy{}shift}

\PYG{c+cm}{Sequential Multiplier, functions similarly to doing long multiplication by hand}
\PYG{c+cm}{*/}
\PYG{k}{module}\PYG{+w}{ }\PYG{n}{Mult\PYGZus{}8bit}\PYG{+w}{ }\PYG{p}{(}
\PYG{+w}{    }\PYG{k}{input}\PYG{+w}{ }\PYG{k+kt}{logic}\PYG{+w}{ }\PYG{p}{[}\PYG{l+m+mi}{7}\PYG{o}{:}\PYG{l+m+mi}{0}\PYG{p}{]}\PYG{+w}{ }\PYG{n}{A}\PYG{p}{,}\PYG{+w}{ }\PYG{n}{B}\PYG{p}{,}\PYG{c+c1}{//8\PYGZhy{}bit Operand inputs }
\PYG{+w}{    }\PYG{k}{input}\PYG{+w}{ }\PYG{k+kt}{logic}\PYG{+w}{ }\PYG{n}{clock}\PYG{p}{,}\PYG{+w}{ }
\PYG{+w}{    }\PYG{k}{input}\PYG{+w}{ }\PYG{k+kt}{logic}\PYG{+w}{ }\PYG{n}{reset\PYGZus{}n}\PYG{p}{,}\PYG{+w}{ }
\PYG{+w}{    }\PYG{k}{input}\PYG{+w}{ }\PYG{k+kt}{logic}\PYG{+w}{ }\PYG{n}{enable}\PYG{p}{,}\PYG{c+c1}{//Enable \PYGZhy{} sets output of operator to floating}
\PYG{+w}{    }\PYG{k}{output}\PYG{+w}{ }\PYG{k+kt}{logic}\PYG{+w}{ }\PYG{p}{[}\PYG{l+m+mi}{7}\PYG{o}{:}\PYG{l+m+mi}{0}\PYG{p}{]}\PYG{+w}{ }\PYG{n}{Y}\PYG{p}{,}\PYG{+w}{ }\PYG{c+c1}{// 8\PYGZhy{}bit Output}
\PYG{+w}{    }\PYG{k}{output}\PYG{+w}{ }\PYG{k+kt}{logic}\PYG{+w}{ }\PYG{n}{done}\PYG{p}{,}\PYG{+w}{ }\PYG{c+c1}{//Done Flag }
\PYG{+w}{    }\PYG{k}{output}\PYG{+w}{ }\PYG{k+kt}{logic}\PYG{+w}{ }\PYG{n}{overflow}\PYG{+w}{ }\PYG{c+c1}{//Overflow Flag}
\PYG{p}{);}

\PYG{c+c1}{//Registers for helping track the current sequence in the multiplication }
\PYG{k+kt}{logic}\PYG{+w}{ }\PYG{p}{[}\PYG{l+m+mi}{15}\PYG{o}{:}\PYG{l+m+mi}{0}\PYG{p}{]}\PYG{+w}{ }\PYG{n}{result}\PYG{p}{;}\PYG{+w}{ }
\PYG{k+kt}{logic}\PYG{+w}{ }\PYG{p}{[}\PYG{l+m+mi}{7}\PYG{o}{:}\PYG{l+m+mi}{0}\PYG{p}{]}\PYG{+w}{  }\PYG{n}{cout}\PYG{p}{;}
\PYG{k+kt}{logic}\PYG{+w}{ }\PYG{p}{[}\PYG{l+m+mi}{15}\PYG{o}{:}\PYG{l+m+mi}{0}\PYG{p}{]}\PYG{+w}{  }\PYG{n}{multiplicand}\PYG{p}{;}\PYG{+w}{ }
\PYG{k+kt}{logic}\PYG{+w}{ }\PYG{p}{[}\PYG{l+m+mi}{3}\PYG{o}{:}\PYG{l+m+mi}{0}\PYG{p}{]}\PYG{+w}{  }\PYG{n}{i}\PYG{p}{;}

\PYG{+w}{    }\PYG{c+c1}{//Needs to trigger only when enable is on or when reseting}
\PYG{+w}{    }\PYG{k}{always}\PYG{+w}{ }\PYG{p}{@(}\PYG{k}{posedge}\PYG{+w}{ }\PYG{p}{(}\PYG{n}{clock}\PYG{+w}{ }\PYG{o}{\PYGZam{}\PYGZam{}}\PYG{+w}{ }\PYG{n}{enable}\PYG{p}{)}\PYG{+w}{ }\PYG{k}{or}\PYG{+w}{ }\PYG{k}{negedge}\PYG{+w}{ }\PYG{n}{reset\PYGZus{}n}\PYG{+w}{ }\PYG{k}{or}\PYG{+w}{ }\PYG{k}{negedge}\PYG{p}{(}\PYG{n}{enable}\PYG{p}{))}\PYG{+w}{ }\PYG{k}{begin}
\PYG{+w}{        }\PYG{c+c1}{//Resets all the registers and the done flag to initial states}
\PYG{+w}{        }\PYG{k}{if}\PYG{p}{(}\PYG{o}{\PYGZti{}}\PYG{n}{reset\PYGZus{}n}\PYG{p}{)}\PYG{+w}{ }\PYG{k}{begin}
\PYG{+w}{            }\PYG{n}{done}\PYG{+w}{            }\PYG{o}{\PYGZlt{}=}\PYG{+w}{ }\PYG{l+m+mb}{1\PYGZsq{}b0}\PYG{p}{;}
\PYG{+w}{            }\PYG{n}{result}\PYG{+w}{          }\PYG{o}{\PYGZlt{}=}\PYG{+w}{ }\PYG{l+m+mi}{0}\PYG{p}{;}
\PYG{+w}{            }\PYG{n}{multiplicand}\PYG{+w}{    }\PYG{o}{\PYGZlt{}=}\PYG{+w}{ }\PYG{n}{A}\PYG{p}{;}
\PYG{+w}{            }\PYG{n}{i}\PYG{+w}{               }\PYG{o}{\PYGZlt{}=}\PYG{+w}{ }\PYG{l+m+mi}{0}\PYG{p}{;}
\PYG{+w}{            }\PYG{n}{cout}\PYG{+w}{            }\PYG{o}{\PYGZlt{}=}\PYG{+w}{ }\PYG{l+m+mi}{0}\PYG{p}{;}
\PYG{+w}{        }\PYG{k}{end}
\PYG{+w}{        }\PYG{c+c1}{//Sets the outputs to floating when the enable is off}
\PYG{+w}{        }\PYG{k}{if}\PYG{p}{(}\PYG{o}{\PYGZti{}}\PYG{n}{enable}\PYG{p}{)}\PYG{k}{begin}
\PYG{+w}{            }\PYG{n}{Y}\PYG{+w}{        }\PYG{o}{\PYGZlt{}=}\PYG{+w}{ }\PYG{l+m+mb}{8\PYGZsq{}bz}\PYG{p}{;}
\PYG{+w}{            }\PYG{n}{done}\PYG{+w}{     }\PYG{o}{\PYGZlt{}=}\PYG{+w}{ }\PYG{l+m+mb}{1\PYGZsq{}bz}\PYG{p}{;}
\PYG{+w}{            }\PYG{n}{overflow}\PYG{+w}{ }\PYG{o}{\PYGZlt{}=}\PYG{+w}{ }\PYG{l+m+mb}{1\PYGZsq{}bz}\PYG{p}{;}
\PYG{+w}{        }\PYG{k}{end}\PYG{+w}{ }\PYG{k}{else}\PYG{+w}{ }\PYG{k}{begin}
\PYG{+w}{            }\PYG{c+c1}{//For loop created using a counter and comparitor}
\PYG{+w}{            }\PYG{c+c1}{//Functionally same as:}
\PYG{+w}{            }\PYG{c+c1}{//  for(int i = 0; i \PYGZlt{} 8; i++) }
\PYG{+w}{            }\PYG{c+c1}{//  counts from 0 to 7 inclusively}
\PYG{+w}{            }\PYG{k}{if}\PYG{p}{(}\PYG{n}{i}\PYG{+w}{ }\PYG{o}{\PYGZlt{}}\PYG{+w}{ }\PYG{l+m+mi}{8}\PYG{p}{)}\PYG{+w}{ }\PYG{k}{begin}
\PYG{+w}{                }\PYG{c+c1}{//Performed on every iteration so the current}
\PYG{+w}{                }\PYG{c+c1}{// sequence in multiplication is correct}
\PYG{+w}{                }\PYG{n}{multiplicand}\PYG{+w}{ }\PYG{o}{\PYGZlt{}=}\PYG{+w}{ }\PYG{n}{multiplicand}\PYG{+w}{ }\PYG{o}{\PYGZlt{}\PYGZlt{}}\PYG{+w}{ }\PYG{l+m+mi}{1}\PYG{p}{;}\PYG{+w}{ }\PYG{c+c1}{//Logical Left Shift}
\PYG{+w}{                                                   }\PYG{c+c1}{//I.E. multiplied by 2}

\PYG{+w}{                }\PYG{c+c1}{//Reads each bit of B and increases the result by the }
\PYG{+w}{                }\PYG{c+c1}{// current left shifted multiplicand}
\PYG{+w}{                }\PYG{k}{if}\PYG{p}{(}\PYG{n}{B}\PYG{p}{[}\PYG{n}{i}\PYG{p}{]}\PYG{+w}{ }\PYG{o}{==}\PYG{+w}{ }\PYG{l+m+mi}{1}\PYG{p}{)}\PYG{+w}{ }\PYG{k}{begin}
\PYG{+w}{                    }\PYG{n}{result}\PYG{+w}{ }\PYG{o}{\PYGZlt{}=}\PYG{+w}{ }\PYG{n}{result}\PYG{+w}{ }\PYG{o}{+}\PYG{+w}{ }\PYG{n}{multiplicand}\PYG{p}{;}
\PYG{+w}{                }\PYG{k}{end}
\PYG{+w}{            }\PYG{c+c1}{//Iterand counting by one to complete for loop functionality}
\PYG{+w}{            }\PYG{n}{i}\PYG{+w}{ }\PYG{o}{\PYGZlt{}=}\PYG{+w}{ }\PYG{n}{i}\PYG{+w}{ }\PYG{o}{+}\PYG{+w}{ }\PYG{l+m+mi}{1}\PYG{p}{;}\PYG{+w}{   }

\PYG{+w}{            }\PYG{c+c1}{//Once the loop has finished the result can be thrown to}
\PYG{+w}{            }\PYG{c+c1}{// the outputs, and the done flag can be raised so the ALU}
\PYG{+w}{            }\PYG{c+c1}{// knows the operation has concluded.}
\PYG{+w}{            }\PYG{k}{end}\PYG{+w}{ }\PYG{k}{else}\PYG{+w}{ }\PYG{k}{begin}
\PYG{+w}{                }\PYG{p}{\PYGZob{}}\PYG{n}{cout}\PYG{p}{,}\PYG{+w}{ }\PYG{n}{Y}\PYG{p}{\PYGZcb{}}\PYG{+w}{   }\PYG{o}{=}\PYG{+w}{ }\PYG{n}{result}\PYG{p}{;}
\PYG{+w}{                }\PYG{c+c1}{//Since the output of a multiplier is 2x number of}
\PYG{+w}{                }\PYG{c+c1}{// input bits and our output is staying at 8 bits}
\PYG{+w}{                }\PYG{c+c1}{// the overflow flag needs to be raised whenever}
\PYG{+w}{                }\PYG{c+c1}{// the result exceeds 8 bits}

\PYG{+w}{                }\PYG{c+c1}{//Done set twice here to hopefully combat race conditions}
\PYG{+w}{                }\PYG{k}{if}\PYG{p}{(}\PYG{n}{cout}\PYG{+w}{ }\PYG{o}{\PYGZgt{}}\PYG{+w}{ }\PYG{l+m+mi}{0}\PYG{p}{)}\PYG{+w}{ }\PYG{k}{begin}\PYG{+w}{ }
\PYG{+w}{                    }\PYG{n}{overflow}\PYG{+w}{ }\PYG{o}{\PYGZlt{}=}\PYG{+w}{ }\PYG{l+m+mi}{1}\PYG{p}{;}\PYG{+w}{ }
\PYG{+w}{                }\PYG{k}{end}\PYG{+w}{ }\PYG{k}{else}\PYG{+w}{ }\PYG{k}{begin}
\PYG{+w}{                    }\PYG{n}{overflow}\PYG{+w}{ }\PYG{o}{\PYGZlt{}=}\PYG{+w}{ }\PYG{l+m+mi}{0}\PYG{p}{;}
\PYG{+w}{                }\PYG{k}{end}
\PYG{+w}{                }\PYG{c+c1}{//Raising the done flag should always be the last}
\PYG{+w}{                }\PYG{c+c1}{// thing it does}
\PYG{+w}{                }\PYG{n}{done}\PYG{+w}{        }\PYG{o}{\PYGZlt{}=}\PYG{+w}{ }\PYG{l+m+mb}{1\PYGZsq{}b1}\PYG{p}{;}
\PYG{+w}{            }\PYG{k}{end}
\PYG{+w}{        }\PYG{k}{end}
\PYG{+w}{    }\PYG{k}{end}

\PYG{k}{endmodule}


