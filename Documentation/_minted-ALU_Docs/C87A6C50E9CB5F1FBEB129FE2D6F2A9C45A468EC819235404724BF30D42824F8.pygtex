\PYG{p}{);}


\PYG{k}{task}\PYG{+w}{ }\PYG{n}{reset}\PYG{p}{();}
\PYG{c+cm}{/*}
\PYG{c+cm}{* Reset Task:}
\PYG{c+cm}{    * Runs the reset pin at active low}
\PYG{c+cm}{    * Should reset all registers to 0 and set done flag to 0}
\PYG{c+cm}{    * And sets outputs to floating}
\PYG{c+cm}{*/}
\PYG{+w}{    }\PYG{n}{reset\PYGZus{}n}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{l+m+mb}{1\PYGZsq{}b0}\PYG{p}{;}
\PYG{+w}{    }\PYG{p}{\PYGZsh{}}\PYG{l+m+mi}{10}\PYG{p}{;}
\PYG{+w}{    }\PYG{n}{reset\PYGZus{}n}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{l+m+mb}{1\PYGZsq{}b1}\PYG{p}{;}
