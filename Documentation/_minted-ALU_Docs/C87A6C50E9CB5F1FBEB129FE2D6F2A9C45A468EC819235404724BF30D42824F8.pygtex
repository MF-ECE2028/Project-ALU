\PYG{+w}{    }\PYG{n}{enable}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{l+m+mb}{1\PYGZsq{}b1}\PYG{p}{;}\PYG{+w}{  }\PYG{c+c1}{//Now test enable at 1}

