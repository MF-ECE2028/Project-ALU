\PYG{+w}{            }\PYG{n}{A\PYGZus{}input}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{n}{A}\PYG{p}{;}\PYG{+w}{ }\PYG{n}{B\PYGZus{}input}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{n}{B}\PYG{p}{;}
\PYG{+w}{            }\PYG{c+c1}{//Calculates expected values and outputs them to expected}
\PYG{+w}{            }\PYG{p}{\PYGZob{}}\PYG{n}{overflow\PYGZus{}catch}\PYG{p}{,}\PYG{+w}{ }\PYG{n}{Y\PYGZus{}exp}\PYG{p}{\PYGZcb{}}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{n}{A}\PYG{+w}{ }\PYG{o}{*}\PYG{+w}{ }\PYG{n}{B}\PYG{p}{;}
\PYG{+w}{            }\PYG{c+c1}{//Overflow Catch exists because of the output size limitation}
\PYG{+w}{            }\PYG{c+c1}{// always overflows when the output is bigger than the output}
\PYG{+w}{            }\PYG{c+c1}{// instead of only when the 9th bit is 1 like for other TBs}
\PYG{+w}{            }\PYG{k}{if}\PYG{p}{(}\PYG{n}{overflow\PYGZus{}catch}\PYG{+w}{ }\PYG{o}{\PYGZgt{}}\PYG{+w}{ }\PYG{l+m+mi}{0}\PYG{p}{)}\PYG{+w}{ }\PYG{k}{begin}\PYG{+w}{ }\PYG{n}{cout\PYGZus{}exp}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{l+m+mi}{1}\PYG{p}{;}\PYG{+w}{ }\PYG{k}{end}\PYG{+w}{ }

\PYG{+w}{            }\PYG{n}{multiply}\PYG{p}{();}\PYG{+w}{ }\PYG{c+c1}{//Run the multiply task to give enough clock cycles}
