\PYG{+w}{                }\PYG{p}{\PYGZdl{}}\PYG{n}{display}\PYG{p}{(}\PYG{l+s}{\PYGZdq{}Failed at \PYGZpc{}dA * \PYGZpc{}dB; Y=\PYGZpc{}d and Y\PYGZus{}exp=\PYGZpc{}d and cout=\PYGZpc{}d and cout\PYGZus{}exp=\PYGZpc{}d\PYGZdq{}}\PYG{p}{,}
\PYG{+w}{                    }\PYG{n}{A}\PYG{p}{,}\PYG{+w}{ }\PYG{n}{B}\PYG{p}{,}\PYG{+w}{ }\PYG{n}{Y\PYGZus{}test}\PYG{p}{,}\PYG{+w}{ }\PYG{n}{Y\PYGZus{}exp}\PYG{p}{,}\PYG{+w}{ }\PYG{n}{cout\PYGZus{}test}\PYG{p}{,}\PYG{+w}{ }\PYG{n}{cout\PYGZus{}exp}\PYG{p}{);}
\PYG{+w}{                }\PYG{c+c1}{//Does not stop at fail to identify the pattern of failure}
\PYG{+w}{                }\PYG{c+c1}{// from test results}
\PYG{+w}{            }\PYG{k}{end}
\PYG{+w}{            }\PYG{n}{reset}\PYG{p}{();}
\PYG{+w}{        }\PYG{k}{end}
\PYG{+w}{    }\PYG{k}{end}
\PYG{+w}{    }\PYG{k}{if}\PYG{p}{(}\PYG{n}{enable}\PYG{+w}{ }\PYG{o}{==}\PYG{+w}{ }\PYG{l+m+mi}{1}\PYG{p}{)}\PYG{+w}{ }\PYG{k}{begin}
\PYG{+w}{        }\PYG{c+c1}{//This is a special case test for when the value should be}
