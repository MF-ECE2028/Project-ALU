\PYG{k}{task}\PYG{+w}{ }\PYG{n}{multiply}\PYG{p}{();}
\PYG{c+cm}{/*}
\PYG{c+cm}{* Multiply Task:}
\PYG{c+cm}{    * Since the multiplier Module runs on a number of clock cycles}
\PYG{c+cm}{    * The test case needs to be predictable for proper comparison}
\PYG{c+cm}{    *}
\PYG{c+cm}{    * Therefore the multiply function runs the clock until the Done flag is}
\PYG{c+cm}{    *  raised. Allowing thee multiplier enough time to complete the}
\PYG{c+cm}{    *  multiplication.}
\PYG{c+cm}{*/}\PYG{+w}{ }
\PYG{+w}{    }\PYG{k}{while}\PYG{+w}{ }\PYG{p}{(}\PYG{n}{Done\PYGZus{}test}\PYG{+w}{ }\PYG{o}{!==}\PYG{+w}{ }\PYG{l+m+mb}{1\PYGZsq{}b1}\PYG{p}{)}\PYG{+w}{ }\PYG{k}{begin}
\PYG{+w}{        }\PYG{n}{clock}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{l+m+mb}{1\PYGZsq{}b1}\PYG{p}{;}
\PYG{+w}{        }\PYG{p}{\PYGZsh{}}\PYG{l+m+mi}{1}\PYG{p}{;}
\PYG{+w}{        }\PYG{n}{clock}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{l+m+mb}{1\PYGZsq{}b0}\PYG{p}{;}
\PYG{+w}{        }\PYG{p}{\PYGZsh{}}\PYG{l+m+mi}{1}\PYG{p}{;}
\PYG{+w}{    }\PYG{k}{end}
\PYG{k}{endtask}

\PYG{k}{task}\PYG{+w}{ }\PYG{n}{validate}\PYG{p}{();}
\PYG{c+cm}{/*}
\PYG{c+cm}{* Validate Task:}
\PYG{c+cm}{    * Iterates through a limited set of values for A and B }
\PYG{c+cm}{    *  and compares the calculated values of multiplication}
\PYG{c+cm}{    *  to the implimented addition module}
\PYG{c+cm}{    *}
\PYG{c+cm}{    * Since the output is limited to 8\PYGZhy{}bits the multiplier }
\PYG{c+cm}{    *  technically only works for two 4\PYGZhy{}bit inputs,}
\PYG{c+cm}{    *  and the each test takes 9 clock cycles}
\PYG{c+cm}{    *  so the test is limited to a 6\PYGZhy{}bit maximum}
\PYG{c+cm}{*/}

\PYG{+w}{    }\PYG{k+kt}{int}\PYG{+w}{ }\PYG{n}{A2}\PYG{p}{;}\PYG{+w}{ }\PYG{c+c1}{//Declare variables for use in later test case}
\PYG{+w}{    }\PYG{k+kt}{int}\PYG{+w}{ }\PYG{n}{B2}\PYG{p}{;}

