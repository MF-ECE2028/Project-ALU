\PYG{+w}{        }\PYG{c+c1}{//If enable is off we should see a floating output}
\PYG{+w}{        }\PYG{k}{if}\PYG{p}{(}\PYG{n}{enable}\PYG{+w}{ }\PYG{o}{==}\PYG{+w}{ }\PYG{l+m+mi}{0}\PYG{p}{)}\PYG{+w}{ }\PYG{k}{begin}
\PYG{+w}{            }\PYG{c+c1}{//Running multiply here causes the module to run forever}
\PYG{+w}{            }\PYG{c+c1}{// Which proves that it works correctly}
\PYG{+w}{            }\PYG{c+c1}{// However this is also why it is commented out.}

\PYG{+w}{            }\PYG{c+c1}{//multiply();}
