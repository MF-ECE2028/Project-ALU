\PYG{c+cm}{Sequential Multiplier Test Bench. Tests one special case, and all possible outputs in multiplying 2 6\PYGZhy{}bit busses}
\PYG{c+cm}{*/}
\PYG{k}{module}\PYG{+w}{ }\PYG{n}{Mult\PYGZus{}8bitTestbench}\PYG{p}{();}

\PYG{c+c1}{//Module Inputs}
\PYG{k+kt}{logic}\PYG{+w}{ }\PYG{p}{[}\PYG{l+m+mi}{7}\PYG{o}{:}\PYG{l+m+mi}{0}\PYG{p}{]}\PYG{+w}{ }\PYG{n}{A\PYGZus{}input}\PYG{p}{,}\PYG{+w}{ }\PYG{n}{B\PYGZus{}input}\PYG{p}{;}
\PYG{k+kt}{logic}\PYG{+w}{ }\PYG{n}{enable}\PYG{p}{,}\PYG{+w}{ }\PYG{n}{clock}\PYG{p}{,}\PYG{+w}{ }\PYG{n}{reset\PYGZus{}n}\PYG{p}{;}

\PYG{c+c1}{//Module Outputs}
\PYG{k+kt}{logic}\PYG{+w}{ }\PYG{p}{[}\PYG{l+m+mi}{7}\PYG{o}{:}\PYG{l+m+mi}{0}\PYG{p}{]}\PYG{+w}{ }\PYG{n}{Y\PYGZus{}test}\PYG{p}{;}
