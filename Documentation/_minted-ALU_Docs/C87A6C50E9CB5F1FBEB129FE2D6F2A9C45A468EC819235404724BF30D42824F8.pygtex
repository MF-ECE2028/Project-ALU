\PYG{k+kt}{logic}\PYG{+w}{ }\PYG{n}{cout\PYGZus{}exp}\PYG{p}{,}\PYG{+w}{ }\PYG{n}{Done\PYGZus{}exp}\PYG{p}{;}

\PYG{c+c1}{//Additional Logic to Help account for overflow}
\PYG{k+kt}{logic}\PYG{+w}{ }\PYG{p}{[}\PYG{l+m+mi}{7}\PYG{o}{:}\PYG{l+m+mi}{0}\PYG{p}{]}\PYG{+w}{ }\PYG{n}{overflow\PYGZus{}catch}\PYG{p}{;}

\PYG{c+c1}{//Module Call}
\PYG{n}{Mult\PYGZus{}8bit}\PYG{+w}{ }\PYG{n}{dut}\PYG{p}{(}
\PYG{+w}{    }\PYG{p}{.}\PYG{n}{A}\PYG{p}{(}\PYG{n}{A\PYGZus{}input}\PYG{p}{),}\PYG{+w}{ }\PYG{p}{.}\PYG{n}{B}\PYG{p}{(}\PYG{n}{B\PYGZus{}input}\PYG{p}{),}
