\PYG{+w}{                }\PYG{n}{A2}\PYG{p}{,}\PYG{+w}{ }\PYG{n}{B2}\PYG{p}{,}\PYG{+w}{ }\PYG{n}{Y\PYGZus{}test}\PYG{p}{,}\PYG{+w}{ }\PYG{n}{Y\PYGZus{}exp}\PYG{p}{,}\PYG{+w}{ }\PYG{n}{cout\PYGZus{}test}\PYG{p}{,}\PYG{+w}{ }\PYG{n}{cout\PYGZus{}exp}\PYG{p}{);}
\PYG{+w}{            }\PYG{c+c1}{//\PYGZdl{}stop;}
\PYG{+w}{        }\PYG{k}{end}
\PYG{+w}{        }\PYG{n}{reset}\PYG{p}{();}
\PYG{+w}{    }\PYG{k}{end}\PYG{+w}{   }
\PYG{k}{endtask}

\PYG{k}{initial}\PYG{+w}{ }\PYG{k}{begin}
\PYG{+w}{    }\PYG{c+c1}{//Initialize Variables}
\PYG{+w}{    }\PYG{n}{enable}\PYG{+w}{  }\PYG{o}{=}\PYG{+w}{ }\PYG{l+m+mb}{1\PYGZsq{}b0}\PYG{p}{;}\PYG{+w}{ }\PYG{c+c1}{//First test enable at 0}
