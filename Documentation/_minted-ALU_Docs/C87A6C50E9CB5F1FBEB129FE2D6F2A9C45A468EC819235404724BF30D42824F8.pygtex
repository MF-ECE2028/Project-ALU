\PYG{+w}{        }\PYG{n}{A2}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{l+m+mi}{255}\PYG{p}{;}
\PYG{+w}{        }\PYG{n}{B2}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{l+m+mi}{128}\PYG{p}{;}
\PYG{+w}{        }\PYG{n}{A\PYGZus{}input}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{n}{A2}\PYG{p}{;}\PYG{+w}{ }
\PYG{+w}{        }\PYG{n}{B\PYGZus{}input}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{n}{B2}\PYG{p}{;}\PYG{+w}{ }
\PYG{+w}{        }\PYG{p}{\PYGZob{}}\PYG{n}{cout\PYGZus{}exp}\PYG{p}{,}\PYG{+w}{ }\PYG{n}{Y\PYGZus{}exp}\PYG{p}{\PYGZcb{}}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{n}{A2}\PYG{+w}{ }\PYG{o}{*}\PYG{+w}{ }\PYG{n}{B2}\PYG{p}{;}

\PYG{+w}{        }\PYG{n}{multiply}\PYG{p}{();}
\PYG{+w}{        }\PYG{p}{\PYGZsh{}}\PYG{l+m+mi}{5}\PYG{p}{;}

\PYG{+w}{        }\PYG{k}{if}\PYG{p}{(}\PYG{n}{cout\PYGZus{}exp}\PYG{+w}{ }\PYG{o}{!==}\PYG{+w}{ }\PYG{n}{cout\PYGZus{}test}\PYG{+w}{ }\PYG{o}{\PYGZam{}\PYGZam{}}\PYG{+w}{ }\PYG{n}{Y\PYGZus{}exp}\PYG{+w}{ }\PYG{o}{!==}\PYG{+w}{ }\PYG{n}{Y\PYGZus{}test}\PYG{+w}{ }\PYG{o}{\PYGZam{}\PYGZam{}}\PYG{+w}{ }\PYG{n}{Done\PYGZus{}test}\PYG{+w}{ }\PYG{o}{!==}\PYG{+w}{ }\PYG{n}{Done\PYGZus{}exp}\PYG{p}{)}\PYG{+w}{ }\PYG{k}{begin}
